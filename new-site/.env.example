# Google Analytics 4 measurement ID (e.g. G-ABC1234XYZ).
# Leave unset (or a placeholder starting with "G-XXX") to disable the GA4 tag entirely.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID (from clarity.microsoft.com → Settings → Overview).
# Leave unset to omit the Clarity session-analytics tag entirely.
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console HTML tag verification code (the content value of the
# meta verification tag GSC gives you when verifying via "HTML tag" method).
# Leave unset to omit the verification meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=
